# ============================================================
# CELDA: Limpieza de columnas del EMA
# ============================================================
# Eliminar columnas sin nombre (Unnamed) y conservar solo regiones reales
ocupacion_limpia = ocupacion_limpia.loc[
    :,
    ocupacion_limpia.columns.notna()
]

# Eliminar columnas que no son regiones
columnas_no_regiones = ['Año', 'Meses']
columnas_regiones = [
    c for c in ocupacion_limpia.columns
    if c not in columnas_no_regiones and not str(c).startswith('Unnamed')
]

print(f"Columnas de regiones detectadas ({len(columnas_regiones)}):")
print(columnas_regiones)

# ============================================================
# CELDA: Pivot long (melt) — EMA ocupación
# ============================================================
import pandas as pd
import numpy as np

# Forward-fill del año (viene solo en la primera fila de cada bloque)
ocupacion_limpia['Año'] = ocupacion_limpia['Año'].ffill()

# Melt: una fila por (Año, Mes, Región, Ocupación)
ema_long = pd.melt(
    ocupacion_limpia,
    id_vars=['Año', 'Meses'],
    value_vars=columnas_regiones,
    var_name='Region',
    value_name='Ocupacion'
)

# Renombrar y limpiar
ema_long = ema_long.rename(columns={'Año': 'Anio', 'Meses': 'Mes'})
ema_long['Anio'] = pd.to_numeric(ema_long['Anio'], errors='coerce')
ema_long['Ocupacion'] = pd.to_numeric(
    ema_long['Ocupacion'].astype(str).str.replace(',', '.').str.strip(),
    errors='coerce'
)

# Eliminar filas sin año o sin mes
ema_long = ema_long.dropna(subset=['Anio', 'Mes'])
ema_long['Anio'] = ema_long['Anio'].astype(int)

print(f"ema_long shape: {ema_long.shape}")
print(ema_long.head(10))

# ============================================================
# CELDA: Normalizar nombres de meses
# ============================================================
MESES_MAP = {
    'enero': 'Enero', 'febrero': 'Febrero', 'marzo': 'Marzo',
    'abril': 'Abril', 'mayo': 'Mayo', 'junio': 'Junio',
    'julio': 'Julio', 'agosto': 'Agosto', 'septiembre': 'Septiembre',
    'octubre': 'Octubre', 'noviembre': 'Noviembre', 'diciembre': 'Diciembre'
}

ema_long['Mes'] = (
    ema_long['Mes']
    .astype(str)
    .str.strip()
    .str.lower()
    .map(MESES_MAP)
)

ema_long = ema_long.dropna(subset=['Mes'])
print(f"ema_long limpio: {ema_long.shape}")
print(ema_long['Region'].unique())

# ============================================================
# CELDA: Cruce con RNT (establecimientos por región/departamento)
# ============================================================
# El RNT trae habitaciones/camas por establecimiento.
# Como el EMA es por región turística (Eje Cafetero, Caribe, etc.),
# agregamos los establecimientos del RNT por departamento y mapeamos
# a las regiones del EMA.

# Mapeo departamento -> región turística EMA
MAPA_REGION = {
    'RISARALDA': 'Eje Cafetero',
    'CALDAS': 'Eje Cafetero',
    'QUINDIO': 'Eje Cafetero',
    'BOGOTA': 'Bogotá D.C.',
    'BOGOTA D.C.': 'Bogotá D.C.',
    'BOLIVAR': 'Cartagena',
    'ATLANTICO': 'Caribe',
    'MAGDALENA': 'Caribe',
    'CESAR': 'Caribe',
    'CORDOBA': 'Caribe',
    'SUCRE': 'Caribe',
    'LA GUAJIRA': 'Caribe',
    'ANTIOQUIA': 'Antioquia',
    'VALLE DEL CAUCA': 'Pacífico',
    'CAUCA': 'Pacífico',
    'NARINO': 'Pacífico',
    'CHOCO': 'Pacífico',
    'SANTANDER': 'Santanderes',
    'NORTE DE SANTANDER': 'Santanderes',
    'CUNDINAMARCA': 'Central',
    'BOYACA': 'Central',
    'TOLIMA': 'Central',
    'HUILA': 'Central',
    'META': 'Llanos Orinoquía',
    'CASANARE': 'Llanos Orinoquía',
    'ARAUCA': 'Llanos Orinoquía',
    'VICHADA': 'Llanos Orinoquía',
    'AMAZONAS': 'Amazonía',
    'CAQUETA': 'Amazonía',
    'PUTUMAYO': 'Amazonía',
    'GUAINIA': 'Amazonía',
    'GUAVIARE': 'Amazonía',
    'VAUPES': 'Amazonía',
    'SAN ANDRES': 'San Andrés y Providencia',
    'SAN ANDRES Y PROVIDENCIA': 'San Andrés y Providencia'
}

# Limpiar RNT
rnt['departamento'] = rnt['departamento'].astype(str).str.strip().str.upper()
rnt['habitaciones'] = pd.to_numeric(rnt['habitaciones'], errors='coerce').fillna(0)
rnt['camas'] = pd.to_numeric(rnt['camas'], errors='coerce').fillna(0)

rnt['Region'] = rnt['departamento'].map(MAPA_REGION)
rnt_reg = (
    rnt.dropna(subset=['Region'])
       .groupby('Region')
       .agg(
           establecimientos=('codigo_rnt', 'count'),
           habitaciones=('habitaciones', 'sum'),
           camas=('camas', 'sum')
       )
       .reset_index()
)

print(f"RNT agregado por región: {rnt_reg.shape}")
print(rnt_reg)

# ============================================================
# CELDA: Construir dataset integrado (01)
# ============================================================
df_integrado = ema_long.merge(rnt_reg, on='Region', how='left')

# Rellenar faltantes con 0
df_integrado[['establecimientos', 'habitaciones', 'camas']] = (
    df_integrado[['establecimientos', 'habitaciones', 'camas']].fillna(0).astype(int)
)

# Ordenar
df_integrado = df_integrado.sort_values(['Anio', 'Mes', 'Region']).reset_index(drop=True)

print(f"df_integrado shape: {df_integrado.shape}")
print(df_integrado.head(10))

# Guardar 01
df_integrado.to_excel('../data/01_turismo_colombia_integrado.xlsx', index=False)
print("✅ Guardado 01_turismo_colombia_integrado.xlsx")

# ============================================================
# CELDA: Limpieza final (02)
# ============================================================
df_limpio = df_integrado.copy()

# Estandarizar nombres de columnas para el index.html
df_limpio = df_limpio.rename(columns={
    'Anio': 'Año',
    'Mes': 'Mes',
    'Region': 'Región',
    'Ocupacion': 'Ocupación (%)'
})

# Eliminar outliers de ocupación (valores fuera de 0-100)
df_limpio = df_limpio[
    (df_limpio['Ocupación (%)'].isna()) |
    ((df_limpio['Ocupación (%)'] >= 0) & (df_limpio['Ocupación (%)'] <= 100))
]

# Eliminar duplicados
df_limpio = df_limpio.drop_duplicates(subset=['Año', 'Mes', 'Región'])

# Eliminar filas sin ocupación (solo si no hay dato)
# (las conservamos con NaN para que el index.html las muestre como "—")

print(f"df_limpio shape: {df_limpio.shape}")
print(f"Años: {sorted(df_limpio['Año'].unique())}")
print(f"Regiones: {sorted(df_limpio['Región'].unique())}")
print(df_limpio.head(10))

# Guardar 02 — ESTE es el que consume el index.html
df_limpio.to_excel('../data/02_turismo_colombia_limpio.xlsx', index=False)
print("✅ Guardado 02_turismo_colombia_limpio.xlsx")

# ============================================================
# CELDA: Modelado / variables derivadas (03)
# ============================================================
df_modelo = df_limpio.copy()

# Mes numérico
MESES_NUM = {m: i+1 for i, m in enumerate(MESES_MAP.values())}
df_modelo['Mes_Num'] = df_modelo['Mes'].map(MESES_NUM)

# Estacionalidad: promedio histórico por mes y región
estacionalidad = (
    df_modelo.groupby(['Región', 'Mes_Num'])['Ocupación (%)']
             .transform('mean')
)
df_modelo['Ocupacion_Estacional'] = estacionalidad

# Desviación respecto a la estacionalidad
df_modelo['Desviacion_Estacional'] = (
    df_modelo['Ocupación (%)'] - df_modelo['Ocupacion_Estacional']
)

# Var interanual por región
df_modelo = df_modelo.sort_values(['Región', 'Año', 'Mes_Num'])
df_modelo['Ocupacion_Anio_Anterior'] = (
    df_modelo.groupby(['Región', 'Mes_Num'])['Ocupación (%)'].shift(12)
)
df_modelo['Var_Interanual'] = (
    df_modelo['Ocupación (%)'] - df_modelo['Ocupacion_Anio_Anterior']
)

# Índice de vulnerabilidad (0-100): combina baja ocupación + alta caída
oc_min, oc_max = df_modelo['Ocupación (%)'].min(), df_modelo['Ocupación (%)'].max()
df_modelo['Indice_Vulnerabilidad'] = (
    (1 - (df_modelo['Ocupación (%)'] - oc_min) / (oc_max - oc_min)) * 60 +
    (-df_modelo['Var_Interanual'].fillna(0).clip(upper=0) / 10) * 40
).clip(0, 100)

print(f"df_modelo shape: {df_modelo.shape}")
print(df_modelo.head(10))

# Guardar 03
df_modelo.to_excel('../data/03_turismo_colombia_modelado.xlsx', index=False)
print("✅ Guardado 03_turismo_colombia_modelado.xlsx")

# ============================================================
# CELDA: Resumen final
# ============================================================
print("\n" + "="*60)
print("RESUMEN DE ARCHIVOS GENERADOS")
print("="*60)
print(f"01_integrado:  {df_integrado.shape[0]:>6} filas × {df_integrado.shape[1]} columnas")
print(f"02_limpio:     {df_limpio.shape[0]:>6} filas × {df_limpio.shape[1]} columnas")
print(f"03_modelado:   {df_modelo.shape[0]:>6} filas × {df_modelo.shape[1]} columnas")
print(f"\nRango temporal: {df_limpio['Año'].min()} – {df_limpio['Año'].max()}")
print(f"Regiones: {df_limpio['Región'].nunique()}")
print(f"\nOcupación promedio por región:")
print(df_limpio.groupby('Región')['Ocupación (%)'].mean().round(2).sort_values(ascending=False))
